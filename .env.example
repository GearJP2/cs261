# Local development only. Copy to .env; never commit real credentials.
COMPOSE_PROJECT_NAME=unisport-buddy
APP_PORT=8000
POSTGRES_HOST_PORT=5433

DEBUG=true
SECRET_KEY=django-insecure-unisport-local-development-only-change-before-sharing
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional additional trusted origins, comma-separated (scheme and port included).
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=unisport
POSTGRES_USER=unisport
POSTGRES_PASSWORD=unisport-local-development
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Linux/WSL: set these to id -u and id -g before building if not 1000.
# Use a non-root host account. Defaults also work with Docker Desktop on macOS/Windows.
LOCAL_UID=1000
LOCAL_GID=1000
